# --- Core ---
# Public hostname for docker-compose.prod.yml (Caddy gets HTTPS for it).
# Example: bingo.yourdomain.com
DOMAIN=bingo.yourdomain.com
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Local dev uses SQLite: run `npm run db:sqlite` (generates a SQLite copy of
# prisma/schema.prisma). For a deployed instance use PostgreSQL, e.g. Neon:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Use the direct (non "-pooler") hostname: the container runs `prisma db push` on boot.
DATABASE_URL="file:./dev.db"
# Optional: how the container waits for PostgreSQL before serving (scripts/startup.mjs)
# STARTUP_MAX_ATTEMPTS=10
# STARTUP_RETRY_BASE_MS=2000
# STARTUP_RETRY_MAX_MS=30000
# Comma separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- Telegram ---
# Token from @BotFather. Leave empty for local development.
TELEGRAM_BOT_TOKEN=
# Bot username used to build t.me referral links. Just the username:
#   TELEGRAM_BOT_USERNAME=etioricabingo_bot
# (no @, no https://t.me/ prefix, or referral links come out as t.me/t.me/...)
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL players reach. Referral links use it, and Telegram refuses
# to open the Mini App over http://localhost. In production:
#   PUBLIC_URL=https://bingo.example.com
# For a domain with no purchase: bingo.<IP-with-dashes>.sslip.io
PUBLIC_URL=http://localhost:5173
# Dev auth lets you log in without Telegram initData. NEVER enable in production.
DEV_MODE=true

# --- Deposit receipt verification ---
# The platform account that must appear on the Telebirr/CBE receipt. If unset,
# these defaults are used, so the app works out of the box.
DEPOSIT_TELEBIRR_ACCOUNT=0972449537
DEPOSIT_TELEBIRR_NAME=Leul
DEPOSIT_CBE_ACCOUNT=1000574677487
DEPOSIT_CBE_NAME=SILMA
# Optional: CBE app headers for the public receipt API
# CBE_APP_ID=
# CBE_APP_VERSION=

# Optional: automatic re-checks of pending receipts before manual review
# RECEIPT_RETRY_INTERVAL_MS=60000
# RECEIPT_RETRY_MAX=5
# RECEIPT_RETRY_BASE_MS=60000

# --- Seeded accounts ---
ADMIN_EMAIL=admin@bingo.et
ADMIN_PASSWORD=Admin@12345
AGENT_EMAIL=agent@bingo.et
AGENT_PASSWORD=Agent@12345

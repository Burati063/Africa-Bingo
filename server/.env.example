# --- Core ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# SQLite for local dev. For Postgres change datasource provider in prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Comma separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- Telegram ---
# Token from @BotFather. Leave empty for local development.
TELEGRAM_BOT_TOKEN=
# Bot username (without @) used to build t.me referral links
TELEGRAM_BOT_USERNAME=
# Public URL of the Mini App / backend (used for referral links when no bot username)
PUBLIC_URL=http://localhost:5173
# Dev auth lets you log in without Telegram initData. NEVER enable in production.
DEV_MODE=true

# --- Deposit receipt verification ---
# The platform account that must appear on the Telebirr/CBE receipt. If unset,
# these defaults are used, so the app works out of the box.
DEPOSIT_TELEBIRR_ACCOUNT=0972449537
DEPOSIT_TELEBIRR_NAME=Leul
DEPOSIT_CBE_ACCOUNT=1000574677487
DEPOSIT_CBE_NAME=SILMA
# Optional: CBE app headers for the public receipt API
# CBE_APP_ID=
# CBE_APP_VERSION=

# Optional: automatic re-checks of pending receipts before manual review
# RECEIPT_RETRY_INTERVAL_MS=60000
# RECEIPT_RETRY_MAX=5
# RECEIPT_RETRY_BASE_MS=60000

# --- Seeded accounts ---
ADMIN_EMAIL=admin@bingo.et
ADMIN_PASSWORD=Admin@12345
AGENT_EMAIL=agent@bingo.et
AGENT_PASSWORD=Agent@12345
